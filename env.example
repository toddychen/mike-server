# Whisper模型配置
WHISPER_MODEL=base

# 服务器配置
PORT=3000

# 文件上传配置
MAX_FILE_SIZE=10485760

# 向量数据库配置
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 新闻API配置
NEWS_API_BASE_URL=https://your-news-api.com
NEWS_API_KEY=your_api_key

# 调度器配置
AUTO_START_SCHEDULER=true
NEWS_FETCH_INTERVAL_HOURS=1
MAX_CONCURRENT_SCRAPES=5

# GPT API配置
OPENAI_API_KEY=your_openai_api_key_here

# 摘要器模型配置
SUMMARIZER_MODEL=gpt-4o-nano

# 其他LLM任务模型配置（预留）
# LLM_TASK_MODEL=gpt-4o

# Hugging Face配置
HF_HOME=data/models

# 管理员配置
ADMIN_SECRET=heymike

# 日志配置
LOG_LEVEL=INFO

# 团队配置
TEAM_IDS=team1,team2,team3
